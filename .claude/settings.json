{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh repo view:*)",
      "Bash(yarn:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(.venv\\Scripts\\python.exe:*)",
      "Bash(pytest:*)",
      "Bash(docker start:*)",
      "Bash(docker version:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git reset --hard origin/main:*)"
    ]
  }
}
