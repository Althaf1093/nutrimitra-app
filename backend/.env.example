# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=nutrimitra

# JWT signing secret (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Groq API key for the AI coach (required for coach/plan/vision features to work)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: OpenAI-compatible base URL (defaults to Groq). Tests point this at a local fake.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Food-photo recognition. VISION_PROVIDER picks the provider: gemini (default), groq, or auto
# (Gemini first, then Groq). Without a key for the chosen provider, photo logging is switched off
# and the app says so; logging meals by hand keeps working.
VISION_PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com/apikey). Paste your own key here, never commit it.
GEMINI_API_KEY=
# Gemini model id; the default is the current Flash model from Google's docs. Change it if Google retires it.
GEMINI_MODEL=gemini-3.8-flash
# Optional Groq vision model, used when VISION_PROVIDER is groq or auto (needs GROQ_API_KEY above).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional base URL for Gemini (defaults to Google). Tests point this at a local fake.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: override the Google OAuth handoff endpoint (defaults to Emergent's managed demo endpoint)
GOOGLE_AUTH_HANDOFF_URL=

# Login/signup rate limit: attempts allowed per window, per client IP and per email (defaults 10 / 15).
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MINUTES=15
# IPs never rate limited. The default exempts loopback for local dev and the test suite;
# set it to an empty value in production.
AUTH_RATE_LIMIT_EXEMPT_IPS=127.0.0.1,::1
# Set to 1 behind a reverse proxy (e.g. Render) so the client IP is read from X-Forwarded-For.
TRUST_PROXY_HEADERS=

# Browser origins allowed to call the API, comma separated. Leave unset for local dev
# (defaults to http://localhost:8081 and http://localhost:19006, plus the 127.0.0.1 forms).
# In production list the deployed web app origin(s), e.g. https://app.example.com
CORS_ORIGINS=
