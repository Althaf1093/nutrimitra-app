# Copy to .env and fill in. Never commit .env.

# Where the app finds the backend (use your PC's LAN IP when testing on a phone).
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Google sign-in: the OAuth "Web application" client ID from Google Cloud Console. It must also be listed in
# GOOGLE_CLIENT_IDS in backend/.env. Leave empty to hide the Google button; email sign-in works either way.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
